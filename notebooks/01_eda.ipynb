{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Attack Pattern Classification Engine - EDA\n",
    "\n",
    "Exploratory Data Analysis for honeypot attack patterns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "# Set style\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (12, 8)\n",
    "plt.rcParams['figure.dpi'] = 100\n",
    "\n",
    "# Load processed data\n",
    "sessions = pd.read_json('../data/processed/sessions.json')\n",
    "features = pd.read_csv('../data/processed/features.csv')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Session Overview"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Session duration distribution\n",
    "fig, axes = plt.subplots(1, 2, figsize=(15, 5))\n",
    "\n",
    "# Histogram\n",
    "sessions['duration'].hist(bins=50, ax=axes[0], edgecolor='black')\n",
    "axes[0].set_xlabel('Duration (seconds)')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "axes[0].set_title('Session Duration Distribution')\n",
    "\n",
    "# Box plot\n",
    "sessions.boxplot(column='duration', ax=axes[1])\n",
    "axes[1].set_ylabel('Duration (seconds)')\n",
    "axes[1].set_title('Session Duration Box Plot')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../docs/session_duration.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Command Frequency Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Top commands\n",
    "from collections import Counter\n",
    "\n",
    "all_commands = []\n",
    "for cmd_list in sessions['commands']:\n",
    "    all_commands.extend(cmd_list)\n",
    "\n",
    "command_counts = Counter(all_commands)\n",
    "top_commands = dict(command_counts.most_common(20))\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.barh(list(top_commands.keys())[::-1], list(top_commands.values())[::-1])\n",
    "plt.xlabel('Frequency')\n",
    "plt.ylabel('Command')\n",
    "plt.title('Top 20 Most Frequent Commands')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../docs/command_frequency.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Cluster Visualization (PCA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.decomposition import PCA\n",
    "\n",
    "# PCA for visualization\n",
    "pca = PCA(n_components=2)\n",
    "features_pca = pca.fit_transform(features.select_dtypes(include=[np.number]).fillna(0))\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "scatter = plt.scatter(features_pca[:, 0], features_pca[:, 1], \
",
    "                   c=sessions['cluster_label'], cmap='tab10', alpha=0.6)\n",
    "plt.xlabel(f'PC1 ({pca.explained_variance_ratio_[0]:.1%} variance)')\n",
    "plt.ylabel(f'PC2 ({pca.explained_variance_ratio_[1]:.1%} variance)')\n",
    "plt.title('Attack Sessions - PCA Visualization')\n",
    "plt.colorbar(scatter, label='Cluster')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../docs/cluster_pca.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Temporal Patterns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Attacks by hour of day\n",
    "sessions['start_hour'] = pd.to_datetime(sessions['start_time']).dt.hour\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "sessions['start_hour'].value_counts().sort_index().plot(kind='bar')\n",
    "plt.xlabel('Hour of Day')\n",
    "plt.ylabel('Number of Attacks')\n",
    "plt.title('Attack Distribution by Hour of Day')\n",
    "plt.xticks(rotation=0)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../docs/temporal_patterns.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Campaign Correlation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Campaign sizes\n",
    "campaign_data = pd.read_json('../data/processed/campaigns.json').T\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.bar(range(len(campaign_data)), campaign_data['unique_ips'])\n",
    "plt.xlabel('Campaign ID')\n",
    "plt.ylabel('Unique IPs')\n",
    "plt.title('Botnet Campaign Sizes')\n",
    "plt.xticks(range(len(campaign_data)), campaign_data.index, rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../docs/campaign_sizes.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  }
 ],
